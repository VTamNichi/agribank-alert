{
  "name": "agribank-alert-functions",
  "description": "Firebase Cloud Functions for Agribank Alert relay and device pairing",
  "version": "1.0.0",
  "engines": {
    "node": ">=18"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.0"
  },
  "scripts": {
